# =============================================================================
# NexusMiner Configuration Example
# =============================================================================
#
# ⚠️  FORMAT: This file uses TOML syntax (.config or .toml extension).
#     JSON format is NO LONGER SUPPORTED. Do NOT use .json files.
#     Rename your config to miner.config or miner.toml.
#
# Copy this file to miner.config and edit the values below.
# Requires Falcon authentication keys (generate with: ./NexusMiner --create-keys).
#
# ─────────────────────────────────────────────────────────────────────────────
# QUICK-START: Choose ONE hardware profile below and uncomment it.
# ─────────────────────────────────────────────────────────────────────────────

[wallet]
ip = "127.0.0.1"
port = 9323            # Stateless lane (primary). Legacy lane = 8323.
mining_channel = 2     # 1 = PRIME  (CPU or GPU)
                       # 2 = HASH   (GPU only — CPU HASH is supported but slow)

# ─────────────────────────────────────────────────────────────────────────────
# [mining]  — explicit channel, genesis, and reward address
# ─────────────────────────────────────────────────────────────────────────────
[mining]
# channel: 1 = Prime (large integer factoring — CPU or FPGA/GPU with PRIME build)
#          2 = Hash  (SHA-3 hashing   — GPU strongly preferred)
channel = 2
genesis = "a174011c93ca1c80bca5388382b167cacd33d3154395ea8f45ac99a8308cd122"
                # Your Tritium account genesis hash (64 hex chars).
                # Get it with the API call: system/get/info
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"
                # Your Nexus address for block rewards. Leave empty for node default.

# ─────────────────────────────────────────────────────────────────────────────
# Hardware Profiles — uncomment ONE block
# ─────────────────────────────────────────────────────────────────────────────

# --- Profile A: CPU PRIME ---------------------------------------------------
# [workers]
# count = 1
# hardware = "cpu"
# [cpu]
# threads = 8           # Number of CPU threads to use for Prime sieving

# --- Profile B: GPU PRIME (requires -DWITH_PRIME -DWITH_GPU_CUDA) -----------
# [workers]
# count = 1
# hardware = "gpu"
# [gpu]
# device = 0            # CUDA device index (0 = first GPU)
# [cpu]
# threads = 2           # Helper threads for Prime post-processing

# --- Profile C: GPU HASH (default — requires -DWITH_GPU_CUDA) ---------------
[workers]
count = 1
hardware = "gpu"

[gpu]
device = 0              # CUDA device index (0 = first GPU)

[cpu]
threads = 1             # Minimal CPU threads for coordination

# ─────────────────────────────────────────────────────────────────────────────
# Network
# ─────────────────────────────────────────────────────────────────────────────
[network]
local_ip = "auto"           # "auto" = detect local IP automatically
keepalive_interval = 12     # Keep-alive ping interval in hours (2× per 24h node session — safety margin)
sim_link = true             # SIM Link: maintain simultaneous stateless+legacy connections
                            # When true, a secondary connection is opened on the complementary
                            # port (9323↔8323) for redundant template delivery and failover.

# GET_BLOCK miner-side rate limit (milliseconds).
# Lower = faster recovery but may trigger node rate-limiting (node enforces ~2000ms minimum).
# 2500ms: safe default (500ms margin above node's 2000ms floor).
# 1000ms: aggressive recovery (requires LLL-TAO PR #283 one-shot bypass on the node).
get_block_interval_ms = 2500

# ─────────────────────────────────────────────────────────────────────────────
# Falcon Authentication (mandatory)
# ─────────────────────────────────────────────────────────────────────────────
[falcon]
# Generate keys with: ./NexusMiner --create-keys
pubkey  = ""    # hex-encoded Falcon-1024 public key
privkey = ""    # hex-encoded Falcon-1024 private key

# ─────────────────────────────────────────────────────────────────────────────
# Colin — Context-Oriented LLP Intelligence Node
# Background diagnostic agent
# ─────────────────────────────────────────────────────────────────────────────
[colin]
enabled = true
report_interval_seconds = 60    # How often Colin prints a diagnostic report

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
[logging]
level = 2       # 0=trace  1=debug  2=info  3=warn
file  = ""      # Leave empty to log to console only

# ─────────────────────────────────────────────────────────────────────────────
# Advanced / Tuning
# ─────────────────────────────────────────────────────────────────────────────
[advanced]
connection_retry_interval = 10    # seconds between reconnect attempts
print_statistics_interval = 60    # seconds between stats printout
ping_interval = 60                # seconds between keepalive pings

