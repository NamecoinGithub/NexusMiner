# =============================================================================
# NexusMiner — GPU Hash Solo Mining (Single GPU)
# =============================================================================
# Channel: 2 (Hash)  Hardware: GPU  Mode: Solo
#
# Hash mining is the primary GPU workload. A single GPU worker is created.
# device = 0 is your first GPU. If you have multiple GPUs, use
# gpu-hash-performance.config instead.
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8325                 # Hash channel port (check hashport in nexus.conf)

[mining]
channel = 2                 # 2 = Hash channel
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 1                   # 1 GPU worker
hardware = "gpu"            # REQUIRED: tells parser to create GPU workers

[gpu]
device = 0                  # GPU index: 0 = first GPU, 1 = second, etc.

[stats]
mode = "console"

[logging]
level = 2

# -----------------------------------------------------------------------------
# [falcon] — Post-quantum Falcon-1024 authentication (required for SOLO mining)
# Generate your keypair with: ./NexusMiner --create-keys
# Then add the output pubkey/privkey hex strings below.
# SECURITY: chmod 600 this config file to protect your private key.
# -----------------------------------------------------------------------------
[falcon]
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"   # Generate with: ./NexusMiner --create-keys
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE" # Keep secret! chmod 600 this file.
enable_disposable_falcon = true          # REQUIRED: enables block signing (safe, upstream-compatible)
