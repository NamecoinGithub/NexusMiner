# =============================================================================
# NexusMiner — Remote CPU Prime Mining with TLS
# =============================================================================
# Channel: 1 (Prime)  Hardware: CPU  Mode: Solo  Connection: Remote TLS
#
# Use this config when your Nexus node is on a different machine (not localhost)
# and is configured with -miningssl=1 in nexus.conf.
#
# NODE REQUIREMENTS (nexus.conf):
#   mining=1
#   miningssl=1
#
# MINER SETUP:
#   1. Fill in wallet.ip (your node's IP or hostname)
#   2. Fill in genesis and reward_address
#   3. Paste your Falcon keys (./NexusMiner --create-keys)
#   4. If node uses a self-signed cert: set tls_ca_cert_path to your CA cert path
#   5. chmod 600 this file
# =============================================================================

[wallet]
ip = "YOUR_NODE_IP_OR_HOSTNAME"   # Remote node IP or DNS name
port = 8323                        # Stateless prime port (must match node miningport)

[mining]
channel = 1
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "0.0.0.0"       # Bind to all interfaces for remote connection
keepalive_interval = 1      # 1-hour keepalive (recommended for remote connections)

[tls]
enable_tls = true           # REQUIRED: remote mining should always use TLS
ssl_port = 0                # 0 = use wallet.port with TLS (forward-reserved for future node SSL port)
tls_ca_cert_path = ""       # Empty = system CA bundle. Set to CA cert path for self-signed certs.
tls_verify_peer = true      # Always verify in production
tls_server_name = ""        # Empty = use wallet.ip. Set if node cert CN differs.

[workers]
count = 4
hardware = "cpu"

[cpu]
threads = 1
efficiency_cores = true
hyperthreading = true
priority = 2
power_limit_percent = 100
target_hashrate = 0

[stats]
mode = "console"

[logging]
level = 2

[falcon]
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
enable_disposable_falcon = true
