# =============================================================================
# NexusMiner — CPU Prime Solo Mining (Performance / High-Core-Count)
# =============================================================================
# Channel: 1 (Prime)  Hardware: CPU  Mode: Solo  Profile: Maximum Performance
#
# Optimised for Threadripper, EPYC, or high-core-count desktop CPUs.
# Uses above-normal priority and all cores. Adjust [workers] count to match
# your physical core count. E.g. 16-core CPU → count = 16
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8323

[mining]
channel = 1
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 8                   # Set to your physical core count

[cpu]
threads = 1                 # 1 thread per worker for prime (sieve is single-threaded)
efficiency_cores = false    # Exclude E-cores for maximum performance on P-cores only
hyperthreading = false      # Physical cores only — HT rarely helps prime mining
priority = 3                # Above-normal priority
power_limit_percent = 100   # Full power
target_hashrate = 0         # Unlimited

[stats]
mode = "console"

[logging]
level = 2
