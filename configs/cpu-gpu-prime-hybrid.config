# =============================================================================
# NexusMiner — Hybrid CPU + GPU Prime Mining
# =============================================================================
# Channel: 1 (Prime)  Hardware: CPU + GPU  Mode: Solo
#
# Combines CPU workers for the sieve pipeline with GPU acceleration.
# The TOML parser creates count CPU workers using the [cpu] section settings.
# GPU workers require JSON format for mixed CPU+GPU worker arrays; however
# this config shows the CPU side of a hybrid rig — run alongside a GPU instance
# or use JSON for true mixed worker arrays.
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8323

[mining]
channel = 1
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 4                   # CPU workers (leave cores free for GPU driver)

[cpu]
threads = 1
efficiency_cores = false    # P-cores only — leave E-cores for GPU driver
hyperthreading = false      # Physical cores only
priority = 2                # Normal priority (GPU driver needs headroom)
power_limit_percent = 80    # Reduce CPU power to leave TDP budget for GPU
target_hashrate = 0

[stats]
mode = "console"

[logging]
level = 2
