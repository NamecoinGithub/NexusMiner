# =============================================================================
# NexusMiner — GPU Hash Solo Mining (Multi-GPU / Performance)
# =============================================================================
# Channel: 2 (Hash)  Hardware: GPU  Mode: Solo  Profile: Maximum Performance
#
# For multi-GPU rigs, the TOML parser creates count GPU workers all using
# the same device index. For per-GPU device assignment, use JSON .conf format.
# This config is optimised for a single powerful GPU at maximum settings.
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8325

[mining]
channel = 2
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 1                   # 1 GPU worker (TOML supports 1 GPU; use JSON for multi-GPU)

[gpu]
device = 0                  # GPU device index

[stats]
mode = "console"

[logging]
level = 2                   # Set to 3 for debug/performance tuning
