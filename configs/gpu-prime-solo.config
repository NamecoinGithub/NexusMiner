# =============================================================================
# NexusMiner — GPU Prime Solo Mining
# =============================================================================
# Channel: 1 (Prime)  Hardware: GPU  Mode: Solo
#
# GPU-accelerated prime mining uses CUDA sieve + Fermat test on the GPU.
# Requires a compatible NVIDIA GPU and NexusMiner built with GPU support.
# If your build does not include GPU prime support, use cpu-prime-solo.config.
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8323                 # Prime channel port

[mining]
channel = 1                 # 1 = Prime channel
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 1                   # 1 GPU prime worker

[gpu]
device = 0                  # GPU device index

[stats]
mode = "console"

[logging]
level = 2
