# =============================================================================
# NexusMiner — Hybrid CPU + GPU Hash Mining
# =============================================================================
# Channel: 2 (Hash)  Hardware: CPU + GPU  Mode: Solo
#
# Hash mining with a GPU worker. The [cpu] section is present for reference
# but hash mining primarily uses the GPU worker. The CPU handles protocol
# communication and block submission. For true multi-GPU setups use JSON format.
#
# REQUIRED: Fill in genesis and reward_address before running.
# =============================================================================

[wallet]
ip = "127.0.0.1"
port = 8325                 # Hash channel port

[mining]
channel = 2
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_NXS_REWARD_ADDRESS_HERE"

[network]
local_ip = "127.0.0.1"
keepalive_interval = 24

[workers]
count = 1                   # GPU worker (TOML: set count=1 for GPU hash)

[gpu]
device = 0                  # Primary GPU

[stats]
mode = "console"

[logging]
level = 2
