# =============================================================================
# NexusMiner — Remote GPU Hash Mining with TLS
# =============================================================================
# Channel: 2 (Hash)  Hardware: GPU  Mode: Solo  Connection: Remote TLS
#
# Use this config when your Nexus node is on a different machine and configured
# with -miningssl=1 in nexus.conf.
#
# NODE REQUIREMENTS (nexus.conf):
#   mining=1
#   miningssl=1
#
# MINER SETUP:
#   1. Fill in wallet.ip (your node's IP or hostname)
#   2. Fill in genesis and reward_address
#   3. Paste your Falcon keys (./NexusMiner --create-keys)
#   4. chmod 600 this file
# =============================================================================

[wallet]
ip = "YOUR_NODE_IP_OR_HOSTNAME"
port = 8325                        # Hash channel port

[mining]
channel = 2
genesis = "YOUR_GENESIS_HASH_HERE"
reward_address = "YOUR_GENESIS_HASH_HERE"  # 64-char hex genesis hash from system/get/info (same as genesis above; NOT a Base58 account address)

[network]
local_ip = "0.0.0.0"
keepalive_interval = 1

[tls]
enable_tls = true
ssl_port = 0
tls_ca_cert_path = ""
tls_verify_peer = true
tls_server_name = ""

[workers]
count = 1
hardware = "gpu"

[gpu]
device = 0

[stats]
mode = "console"

[logging]
level = 2

[falcon]
pubkey = "YOUR_FALCON_PUBKEY_HEX_HERE"
privkey = "YOUR_FALCON_PRIVKEY_HEX_HERE"
enable_disposable_falcon = true
