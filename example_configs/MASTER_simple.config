# =============================================================================
#                 NEXUSMINER SIMPLE CONFIGURATION
#                    Quick Start for New Miners
# =============================================================================
#
# Minimal configuration to get started with NexusMiner.
# Perfect for testing or simple single-GPU/CPU setups.
#
# Quick Start:
# 1. Generate keys: ./NexusMiner --create-keys
# 2. Paste your keys below
# 3. Choose mining_mode: "HASH" (GPU) or "PRIME" (CPU)
# 4. Run: ./NexusMiner miner.config
#
# =============================================================================

version = 1

# Connection to your Nexus node
wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"

# Mining mode: "HASH" (GPU) or "PRIME" (CPU)
mining_mode = "HASH"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================
# ⚠️ NEVER commit private keys to version control or share them!
# Generate with: ./NexusMiner --create-keys

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = ""
print_statistics_interval = 10

# =============================================================================
#                    MINING REWARDS
# =============================================================================
# Get your address via: finance/list/accounts in Nexus wallet

[mining]
reward_address = "YOUR_NXS_ACCOUNT_ADDRESS_HERE"

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

# =============================================================================
#                         WORKER
# =============================================================================
# Single GPU worker - perfect for getting started
# Change hardware to "cpu" and add threads for CPU mining

[[workers]]
id = "gpu0"
hardware = "gpu"
device = 0
power_limit_percent = 80

# =============================================================================
#                    NEXT STEPS
# =============================================================================
#
# For multi-GPU setup, add more [[workers]] sections:
#   [[workers]]
#   id = "gpu1"
#   hardware = "gpu"
#   device = 1
#   power_limit_percent = 80
#
# For CPU mining, use:
#   [[workers]]
#   id = "cpu0"
#   hardware = "cpu"
#   threads = 1
#   priority = 2
#
# See MASTER_REFERENCE.config for all available options.
# =============================================================================
