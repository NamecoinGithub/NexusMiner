# =============================================================================
#              NEXUSMINER CPU MULTI-CORE CONFIGURATION
#               Ready-to-Use for 8-Core CPU Mining
# =============================================================================
#
# Default: 8 workers configured for 8-core CPU
# Adjust the number of [[workers]] sections to match your CPU core count.
#
# QUICK START:
# 1. Generate Falcon keys: ./NexusMiner --create-keys
# 2. Paste public and private keys below
# 3. Adjust worker count to match your CPU cores
# 4. Save as 'miner.config' and run: ./NexusMiner miner.config
#
# =============================================================================

version = 1

# =============================================================================
#                    CONNECTION (ESSENTIAL)
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"

# Use PRIME for CPU mining (or HASH for GPU)
mining_mode = "PRIME"

# =============================================================================
#                FALCON AUTHENTICATION (ESSENTIAL)
# =============================================================================
# Run: ./NexusMiner --create-keys to generate your keys

miner_falcon_pubkey = "<YOUR_FALCON_PUBLIC_KEY_HEX>"
miner_falcon_privkey = "<YOUR_FALCON_PRIVATE_KEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                       LOGGING
# =============================================================================

log_level = 2
logfile = ""

# =============================================================================
#                   STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

# =============================================================================
#           CPU WORKERS (8 workers for 8-core CPU)
# =============================================================================
# Add or remove [[workers]] sections to match your core count.
# Priority: 2=normal, 3=above_normal (for dedicated rigs)

[[workers]]
id = "cpu0"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu1"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu2"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu3"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu4"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu5"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu6"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

[[workers]]
id = "cpu7"
hardware = "cpu"
threads = 1
priority = 3
power_limit_percent = 100

# =============================================================================
#                    CONFIGURATION GUIDE
# =============================================================================
#
# SETTINGS REFERENCE:
# - threads: 1 for PRIME mining (1 worker per core)
# - priority: 0=low, 1=below_normal, 2=normal, 3=above_normal, 4=high
# - power_limit_percent: 50-100 (CPU power throttling)
# - hyperthreading: true=use all logical cores (add to worker if needed)
# - efficiency_cores: true=use E-cores on hybrid CPUs (add if needed)
#
# SCALING:
# - 4-core CPU: Remove cpu4-cpu7 workers
# - 16-core CPU: Copy workers and add cpu8-cpu15
# - Leave 1-2 cores free on desktop PCs for system responsiveness
#
# HYBRID CPUs (Intel 12th gen+):
# Add to worker sections:
#   efficiency_cores = false  # Use only P-cores for better mining
# =============================================================================
