# =============================================================================
#              NEXUSMINER SOLO PRIME MINING CONFIGURATION
#                   CPU Mining with Full Options
# =============================================================================
#
# Complete configuration for solo CPU mining on the PRIME channel.
# Includes logging to file and all power control options.
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"
mining_mode = "PRIME"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================
# ⚠️ NEVER commit private keys to version control or share them!

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                          TIMING
# =============================================================================

connection_retry_interval = 5
get_height_interval = 2
ping_interval = 10

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = "miner.log"
print_statistics_interval = 10

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

[[stats_printers]]
mode = "file"
filename = "stats.log"

# =============================================================================
#                          WORKERS
# =============================================================================
# Example: 4 CPU workers for a 4-core CPU
# Adjust count based on your CPU

[[workers]]
id = "cpu0"
hardware = "cpu"
threads = 1
priority = 2
power_limit_percent = 85
hyperthreading = true
efficiency_cores = true
target_hashrate = 0

[[workers]]
id = "cpu1"
hardware = "cpu"
threads = 1
priority = 2
power_limit_percent = 85
hyperthreading = true
efficiency_cores = true
target_hashrate = 0

[[workers]]
id = "cpu2"
hardware = "cpu"
threads = 1
priority = 2
power_limit_percent = 85
hyperthreading = true
efficiency_cores = true
target_hashrate = 0

[[workers]]
id = "cpu3"
hardware = "cpu"
threads = 1
priority = 2
power_limit_percent = 85
hyperthreading = true
efficiency_cores = true
target_hashrate = 0
