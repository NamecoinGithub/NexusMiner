# =============================================================================
#              NEXUSMINER MULTI-GPU HASH MINING CONFIGURATION
#                    Optimized for Multiple GPUs
# =============================================================================
#
# Configuration for mining with multiple GPUs on the HASH channel.
# Adjust the device numbers and power settings for your rig.
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"
mining_mode = "HASH"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = "multi_gpu.log"
print_statistics_interval = 30

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

[[stats_printers]]
mode = "file"
filename = "stats.log"

# =============================================================================
#                     GPU WORKERS
# =============================================================================
# One [[workers]] section per GPU
# Adjust device index and power settings per card

# GPU 0 - Primary GPU
[[workers]]
id = "gpu0"
hardware = "gpu"
device = 0
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 70
target_hashrate = 0

# GPU 1
[[workers]]
id = "gpu1"
hardware = "gpu"
device = 1
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 70
target_hashrate = 0

# GPU 2
[[workers]]
id = "gpu2"
hardware = "gpu"
device = 2
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 70
target_hashrate = 0

# GPU 3
[[workers]]
id = "gpu3"
hardware = "gpu"
device = 3
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 70
target_hashrate = 0

# =============================================================================
#                    ADDITIONAL GPUS
# =============================================================================
# Copy and paste for more GPUs:
#
# [[workers]]
# id = "gpu4"
# hardware = "gpu"
# device = 4
# power_limit_percent = 80
# core_clock_offset = 0
# memory_clock_offset = 0
# fan_speed = 70
# target_hashrate = 0

# =============================================================================
#                    TUNING TIPS
# =============================================================================
#
# 1. Start with power_limit_percent = 80 for all cards
# 2. Monitor temperatures and adjust fan_speed if needed
# 3. Each GPU can have different settings based on its capabilities
# 4. Use nvidia-smi or rocm-smi to identify device indices
# 5. Reduce power_limit_percent if running hot
# 6. Increase memory_clock_offset gradually for more hashrate
#
# =============================================================================
