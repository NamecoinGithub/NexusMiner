# =============================================================================
#              NEXUSMINER REMOTE TLS MINING CONFIGURATION
#             Secure Remote Mining with Encrypted Connections
# =============================================================================
#
# Configuration for mining over the network with TLS/HTTPS security.
# Use this when connecting to a remote Nexus node.
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

# Remote node address (hostname or IP)
wallet_ip = "mining.pool.com"
port = 8323
local_ip = "0.0.0.0"

mining_mode = "PRIME"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                     TLS CONFIGURATION
# =============================================================================

# Enable TLS/HTTPS for encrypted connections
enable_tls = true

# Verify server certificate (always true in production!)
tls_verify_peer = true

# CA certificate path (empty = use system defaults)
tls_ca_cert_path = ""

# Server name for SNI (match your server's certificate)
tls_server_name = "mining.pool.com"

# =============================================================================
#                  MUTUAL TLS (Optional)
# =============================================================================
# Uncomment for client certificate authentication:
#
# tls_client_cert_path = "/path/to/client-cert.pem"
# tls_client_key_path = "/path/to/client-key.pem"
# tls_client_key_password = "optional_password"

# =============================================================================
#                    MINING REWARDS (NEW)
# =============================================================================
# reward_address is now the primary way to receive mining rewards
# Use any valid NXS address (no longer limited to tritium_genesis)

[mining]
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"

# =============================================================================
#                   ENHANCED SECURITY
# =============================================================================

# ChaCha20-Poly1305 encryption for Falcon pubkey
# Auto-enabled for remote connections, explicit here for clarity
enable_chacha20_wrapping = true

# Block signing (optional - adds overhead)
enable_block_signing = false

# Keep-alive interval in hours
keepalive_interval = 24

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = "remote_mining.log"
print_statistics_interval = 10

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

[[stats_printers]]
mode = "file"
filename = "stats.log"

# =============================================================================
#                          WORKERS
# =============================================================================

[[workers]]
id = "gpu0"
hardware = "gpu"
device = 0
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 0
target_hashrate = 0

# =============================================================================
#                     SECURITY NOTES
# =============================================================================
#
# 1. Always use TLS for remote connections
# 2. Keep tls_verify_peer = true to prevent MITM attacks
# 3. Consider using VPN for additional security layer
# 4. Never share or commit private keys
# 5. ChaCha20 wrapping auto-enables for non-localhost connections
# 6. Use client certificates (mTLS) for strongest authentication
#
# =============================================================================
