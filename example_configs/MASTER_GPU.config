# =============================================================================
#                 NEXUSMINER GPU MINING CONFIGURATION
#                    Optimized for NVIDIA/AMD GPUs
# =============================================================================
#
# TOML Configuration for HASH (GPU) Mining
# Add one worker section per GPU in your system
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"

# Set to HASH for GPU mining
mining_mode = "HASH"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================
# Generate keys with: ./NexusMiner --create-keys

miner_falcon_pubkey = "<YOUR_897_BYTE_FALCON_PUBLIC_KEY_HEX>"
miner_falcon_privkey = "<YOUR_1281_BYTE_FALCON_PRIVATE_KEY_HEX>"
tritium_genesis = "<YOUR_64_CHARACTER_GENESIS_HASH_HEX>"

# =============================================================================
#                       GPU POWER CONTROLS
# =============================================================================
# power_limit_percent  - Power limit: 50-100% (recommended: 75-80%)
# core_clock_offset    - Clock offset in MHz (-500 to +500)
# memory_clock_offset  - Memory clock offset in MHz (-1000 to +1000)
# fan_speed            - Fan: 0=auto, 1-100=fixed percentage

# =============================================================================
#                          TIMING
# =============================================================================

connection_retry_interval = 5
get_height_interval = 2
ping_interval = 10
print_statistics_interval = 30
keepalive_interval = 24

# =============================================================================
#                    MINING REWARDS (NEW)
# =============================================================================
# reward_address is now the primary way to receive mining rewards
# Use any valid NXS address (no longer limited to tritium_genesis)

[mining]
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"

# =============================================================================
#                         SECURITY
# =============================================================================

enable_tls = false
enable_chacha20_wrapping = false
enable_block_signing = false

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = ""

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

# =============================================================================
#                        GPU WORKERS
# =============================================================================
# One worker per GPU. Device index starts at 0.
# List your GPUs with: nvidia-smi (NVIDIA) or rocm-smi (AMD)
# =============================================================================

# GPU 0 - Primary
[[workers]]
id = "gpu0"
hardware = "gpu"
device = 0
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 0

# =============================================================================
#                    MULTI-GPU SETUP
# =============================================================================
# Copy and uncomment sections for additional GPUs:
#
# # GPU 1
# [[workers]]
# id = "gpu1"
# hardware = "gpu"
# device = 1
# power_limit_percent = 80
# core_clock_offset = 0
# memory_clock_offset = 0
# fan_speed = 0
#
# # GPU 2
# [[workers]]
# id = "gpu2"
# hardware = "gpu"
# device = 2
# power_limit_percent = 80
# core_clock_offset = 0
# memory_clock_offset = 0
# fan_speed = 0
#
# # GPU 3
# [[workers]]
# id = "gpu3"
# hardware = "gpu"
# device = 3
# power_limit_percent = 80
# core_clock_offset = 0
# memory_clock_offset = 0
# fan_speed = 0

# =============================================================================
#                    POWER EFFICIENCY GUIDE
# =============================================================================
# power_limit_percent recommendations:
#
# 100%    - Maximum performance, highest power draw
# 80-85%  - Balanced (best efficiency vs performance ratio)
# 70-75%  - Efficiency focused (lower power, moderate hashrate)
# 50-65%  - Ultra-efficient (minimal power consumption)
#
# Tip: Start at 80% and adjust based on temperature/hashrate
# =============================================================================

# =============================================================================
#                    OVERCLOCKING GUIDE
# =============================================================================
# core_clock_offset:
#   -500 to -100  - Undervolt (lower power, may improve efficiency)
#   0             - Stock (default)
#   +50 to +200   - Moderate overclock
#   +200 to +500  - Aggressive overclock (monitor temps!)
#
# memory_clock_offset:
#   -500 to 0     - Reduce memory errors
#   +200 to +500  - Moderate overclock
#   +500 to +1000 - Aggressive (test stability!)
#
# fan_speed:
#   0       - Auto (GPU controls fan)
#   60-80   - Fixed percentage for consistent cooling
#   100     - Maximum cooling (loud)
# =============================================================================
