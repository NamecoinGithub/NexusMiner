# =============================================================================
#                 NEXUSMINER CPU MINING CONFIGURATION
#            Optimized for Multi-Core CPUs (Threadripper, EPYC, etc)
# =============================================================================
#
# TOML Configuration for PRIME (CPU) Mining
# Recommended: 1 worker per CPU core, adjust worker count to match your CPU
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"

# Set to PRIME for CPU mining
mining_mode = "PRIME"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================
# Generate keys with: ./NexusMiner --create-keys

miner_falcon_pubkey = "<YOUR_897_BYTE_FALCON_PUBLIC_KEY_HEX>"
miner_falcon_privkey = "<YOUR_1281_BYTE_FALCON_PRIVATE_KEY_HEX>"
tritium_genesis = "<YOUR_64_CHARACTER_GENESIS_HASH_HEX>"

# =============================================================================
#                       CPU POWER CONTROLS
# =============================================================================
# threads      - Threads per worker (PRIME: use 1 thread per worker)
# affinity_mask - CPU affinity bitmask (0 = any core, recommended)
# priority     - Thread priority: 0=low, 1=below_normal, 2=normal,
#                                 3=above_normal, 4=high
# power_limit_percent - Power limit: 50-100%

# =============================================================================
#                          TIMING
# =============================================================================

connection_retry_interval = 5
get_height_interval = 2
ping_interval = 10
print_statistics_interval = 30
keepalive_interval = 24

# =============================================================================
#                    MINING REWARDS (NEW)
# =============================================================================
# reward_address is now the primary way to receive mining rewards
# Use any valid NXS address (no longer limited to tritium_genesis)

[mining]
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"

# =============================================================================
#                         SECURITY
# =============================================================================

enable_tls = false
enable_chacha20_wrapping = false
enable_block_signing = false

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = ""

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

# =============================================================================
#                        CPU WORKERS
# =============================================================================
# Each worker = 1 mining thread. Add more workers for more cores.
# Recommended: Use 75% of your cores (leave headroom for system)
#
# Scaling Guide:
# - 4-core CPU:  3 workers
# - 8-core CPU:  6 workers
# - 16-core CPU: 12 workers
# - 32-core CPU: 24 workers
# - 64-core CPU: 48 workers
# - 128-core Threadripper: 96 workers
#
# Copy and paste worker sections as needed, incrementing the id.
# =============================================================================

[[workers]]
id = "cpu0"
hardware = "cpu"
threads = 1
affinity_mask = 0
priority = 2
power_limit_percent = 90

[[workers]]
id = "cpu1"
hardware = "cpu"
threads = 1
affinity_mask = 0
priority = 2
power_limit_percent = 90

[[workers]]
id = "cpu2"
hardware = "cpu"
threads = 1
affinity_mask = 0
priority = 2
power_limit_percent = 90

[[workers]]
id = "cpu3"
hardware = "cpu"
threads = 1
affinity_mask = 0
priority = 2
power_limit_percent = 90

# =============================================================================
#                    ADDITIONAL WORKERS
# =============================================================================
# Uncomment and copy as needed for more cores:
#
# [[workers]]
# id = "cpu4"
# hardware = "cpu"
# threads = 1
# affinity_mask = 0
# priority = 2
# power_limit_percent = 90
#
# [[workers]]
# id = "cpu5"
# hardware = "cpu"
# threads = 1
# affinity_mask = 0
# priority = 2
# power_limit_percent = 90

# =============================================================================
#                      PRIORITY LEVELS
# =============================================================================
# 0 = Low:          Background mining, minimal system impact
# 1 = Below Normal: Mining while using PC for other tasks
# 2 = Normal:       Default, balanced (recommended)
# 3 = Above Normal: Dedicated mining rig
# 4 = High:         Maximum performance (not recommended for daily use)
# =============================================================================

# =============================================================================
#                   HYBRID CPU OPTIONS
# =============================================================================
# For Intel 12th gen+ hybrid CPUs with P-cores and E-cores:
#
# Add these options to worker sections:
# hyperthreading = true      # Enable SMT/Hyper-Threading (default: true)
# efficiency_cores = true    # Use E-cores (default: true)
#
# For best mining performance on hybrid CPUs:
# efficiency_cores = false   # Use only P-cores
# =============================================================================
