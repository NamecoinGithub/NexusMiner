# =============================================================================
#           NEXUSMINER HYBRID CPU + GPU MINING CONFIGURATION
#               Combined CPU and GPU Mining Setup
# =============================================================================
#
# Configuration for mining with both CPU and GPU workers.
# Note: CPU workers mine PRIME channel, GPU workers mine HASH channel.
# The mining_mode setting determines which channel is active.
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"

# Choose your primary mining channel
# "HASH" - Uses GPU workers
# "PRIME" - Uses CPU workers
mining_mode = "HASH"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                    MINING REWARDS (NEW)
# =============================================================================
# reward_address is now the primary way to receive mining rewards
# Use any valid NXS address (no longer limited to tritium_genesis)

[mining]
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"

# =============================================================================
#                          LOGGING
# =============================================================================

log_level = 2
logfile = ""
print_statistics_interval = 30

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

# =============================================================================
#                       GPU WORKERS
# =============================================================================
# Active when mining_mode = "HASH"

[[workers]]
id = "gpu0"
hardware = "gpu"
device = 0
power_limit_percent = 80
core_clock_offset = 0
memory_clock_offset = 0
fan_speed = 0

# =============================================================================
#                       CPU WORKERS
# =============================================================================
# Active when mining_mode = "PRIME"
# Uncomment and adjust for your CPU

# [[workers]]
# id = "cpu0"
# hardware = "cpu"
# threads = 1
# priority = 2
# power_limit_percent = 90

# [[workers]]
# id = "cpu1"
# hardware = "cpu"
# threads = 1
# priority = 2
# power_limit_percent = 90

# [[workers]]
# id = "cpu2"
# hardware = "cpu"
# threads = 1
# priority = 2
# power_limit_percent = 90

# [[workers]]
# id = "cpu3"
# hardware = "cpu"
# threads = 1
# priority = 2
# power_limit_percent = 90

# =============================================================================
#                        USAGE NOTES
# =============================================================================
#
# Switching Between Channels:
# 1. To mine HASH (GPU): Set mining_mode = "HASH"
# 2. To mine PRIME (CPU): Set mining_mode = "PRIME" and uncomment CPU workers
#
# You can define both CPU and GPU workers in this file.
# Only the workers matching the mining_mode will be used.
#
# For true simultaneous mining on both channels, run two separate
# miner instances with different configuration files.
#
# =============================================================================
