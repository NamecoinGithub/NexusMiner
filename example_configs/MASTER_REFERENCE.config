# =============================================================================
#                     NEXUSMINER MASTER REFERENCE
#                Complete Documentation of ALL Available Options
# =============================================================================
#
# This file documents every configuration option available in NexusMiner.
# Use this as a reference when configuring your miner.
#
# File format: TOML (Tom's Obvious Minimal Language)
# - Comments start with #
# - Strings are quoted: "value"
# - Numbers are unquoted: 8323
# - Booleans are lowercase: true, false
# - Arrays use brackets: [item1, item2]
# - Sections use: [section_name]
# - Nested sections use: [[section.subsection]] for arrays
#
# =============================================================================

# Configuration version (required)
version = 1

# =============================================================================
#                         CONNECTION SETTINGS
# =============================================================================

# IP address or hostname of Nexus node
# Examples: "127.0.0.1" (localhost), "192.168.1.100" (LAN), "mynexusnode.com" (remote)
wallet_ip = "127.0.0.1"

# Port number for stateless miner LLP protocol
# Default: 8323 (matches LLL-TAO's default miningport)
port = 8323

# Local interface to bind to
# "0.0.0.0" - bind to all interfaces (recommended)
# "127.0.0.1" - localhost only
# "192.168.1.50" - bind to specific IP
local_ip = "0.0.0.0"

# =============================================================================
#                           MINING MODE
# =============================================================================

# Mining channel selection
# "PRIME" - CPU mining (prime number search)
# "HASH" - GPU mining (hash computation)
mining_mode = "PRIME"

# =============================================================================
#                      FALCON AUTHENTICATION
#                  Post-Quantum Cryptography Keys
# =============================================================================
# Falcon-512 provides quantum-resistant authentication for secure mining.
# Generate keys with: ./NexusMiner --create-keys

# Falcon-512 public key (897 bytes hex-encoded = 1794 hex characters)
# This key is shared with the Nexus node for authentication
miner_falcon_pubkey = "<YOUR_897_BYTE_FALCON_PUBLIC_KEY_HEX>"

# Falcon-512 private key (1281 bytes hex-encoded = 2562 hex characters)
# ⚠️ KEEP SECRET! Never share or commit to version control!
miner_falcon_privkey = "<YOUR_1281_BYTE_FALCON_PRIVATE_KEY_HEX>"

# Enable physical block signatures stored on blockchain
# Adds ~809 bytes per block submission (emergency backup system)
# Default: false (disabled for performance)
enable_block_signing = false

# =============================================================================
#                     STATELESS MINING (Genesis & Rewards)
# =============================================================================

# Tritium account genesis hash for reward binding (32 bytes hex = 64 chars)
# Get from: nexus list accounts
# Optional but recommended for account-specific mining
tritium_genesis = "<YOUR_64_CHARACTER_GENESIS_HASH_HEX>"

# Keep-alive ping interval in hours (1-168 hours, default: 24)
# Controls how often the miner sends keep-alive pings to maintain session
keepalive_interval = 24

# ChaCha20-Poly1305 encryption for Falcon pubkey
# Auto-enabled for remote mining (non-localhost)
# Adds 28 bytes overhead (12-byte nonce + 16-byte auth tag)
enable_chacha20_wrapping = false

# =============================================================================
#                        MINING REWARDS (NEW!)
#             Configure where mining rewards are sent
# =============================================================================
# ⚠️ NEW: reward_address is now the primary way to receive mining rewards
# You can use ANY valid NXS address - no longer limited to tritium_genesis

[mining]
# NXS account address for mining rewards (stateless mining)
# Get your address via: finance/list/accounts in Nexus wallet
# Base58 encoded, typically 49-52 characters
# This is the NEW preferred method for receiving rewards
reward_address = "8BMeGoCm4TysEn4MseoEwme9yVwkWRqGPYC4m1iHsFzb16udDRg"

# =============================================================================
#                     TLS/SSL ENCRYPTION
# =============================================================================

# Enable TLS/SSL for encrypted connections
# Auto-detected for remote mining (non-localhost)
enable_tls = false

# Path to CA certificate bundle file
# Empty = use system default CA certificates
# Examples: "/etc/ssl/certs/ca-certificates.crt", "/path/to/custom-ca.pem"
tls_ca_cert_path = ""

# Verify peer TLS certificate
# ⚠️ Only disable for testing! Production should always verify.
tls_verify_peer = true

# Server Name Indication for TLS handshake
# Empty = use wallet_ip value
tls_server_name = ""

# =============================================================================
#                     MUTUAL TLS (Client Certificates)
# =============================================================================

# Path to client certificate file (PEM format)
# Example: "/path/to/client-cert.pem"
tls_client_cert_path = ""

# Path to client private key file (PEM format)
# Example: "/path/to/client-key.pem"
tls_client_key_path = ""

# Password for encrypted client key (optional)
# Leave empty if key is not password-protected
tls_client_key_password = ""

# =============================================================================
#                          LOGGING
# =============================================================================

# Logging verbosity level
# 0 = TRACE - Extremely verbose, debug everything
# 1 = DEBUG - Detailed debug information
# 2 = INFO  - Normal informational messages (default)
# 3 = WARN  - Warnings only
# 4 = ERROR - Errors only
# 5 = CRITICAL - Critical errors only
log_level = 2

# Path to log file (empty = console output only)
# Examples: "./nexusminer.log", "/var/log/nexusminer/miner.log"
logfile = ""

# =============================================================================
#                    TIMING PARAMETERS
# =============================================================================

# Seconds to wait before retrying failed connection (1-300)
connection_retry_interval = 5

# Statistics print interval in seconds (1-3600)
# 30 seconds recommended for normal operation, 5-10 for testing
print_statistics_interval = 30

# ⚠️ DEPRECATED - Legacy parameter (unused in Phase 2 stateless)
get_height_interval = 2

# ⚠️ DEPRECATED - Legacy pool parameter (unused in solo mining)
ping_interval = 10

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

# Console statistics printer
[[stats_printers]]
mode = "console"

# File statistics printer (optional - uncomment to use)
# [[stats_printers]]
# mode = "file"
# filename = "stats.log"

# =============================================================================
#                    WORKER CONFIGURATION
# =============================================================================
# Workers define your mining units (CPU cores, GPUs, or FPGAs)
# Each [[workers]] section defines one worker

# -----------------------------------------------------------------------------
#                       GPU WORKER EXAMPLE
# -----------------------------------------------------------------------------

[[workers]]
id = "gpu0"                         # Unique worker identifier
hardware = "gpu"                    # Worker type: "cpu", "gpu", or "fpga"

# GPU device index (0, 1, 2, etc.)
# List GPUs with: nvidia-smi or rocm-smi
device = 0

# GPU power limit percentage (50-100%)
# Recommended: 75-85% for best efficiency vs performance ratio
power_limit_percent = 80

# Core clock offset in MHz (-500 to +500)
# Negative = undervolt, Positive = overclock
core_clock_offset = 0

# Memory clock offset in MHz (-1000 to +1000)
memory_clock_offset = 0

# Fan speed control
# 0 = auto, 1-100 = fixed percentage
fan_speed = 0

# Target hashrate limit (hashes/second)
# 0 = maximum (no limit)
target_hashrate = 0

# -----------------------------------------------------------------------------
#                       CPU WORKER EXAMPLE
# -----------------------------------------------------------------------------
# For PRIME mining, use 1 thread per worker and create multiple workers
# For HASH mining, use multiple threads in a single worker

# [[workers]]
# id = "cpu0"                       # Unique worker identifier
# hardware = "cpu"                  # Worker type
# 
# # Number of threads per worker
# # PRIME mining: Use 1 thread per worker, create multiple workers
# # HASH mining: Use multiple threads (match your core count)
# threads = 1
# 
# # CPU affinity bitmask (0 = no affinity, let OS decide)
# # Bit 0 = core 0, Bit 1 = core 1, etc.
# affinity_mask = 0
# 
# # Thread priority level
# # 0 = low, 1 = below_normal, 2 = normal, 3 = above_normal, 4 = high
# priority = 2
# 
# # CPU power limit percentage (50-100%)
# power_limit_percent = 100
# 
# # Enable SMT/Hyper-Threading cores
# hyperthreading = true
# 
# # Use E-cores on hybrid CPUs (Intel 12th gen+)
# # Set to false to use only P-cores for better mining performance
# efficiency_cores = true
# 
# # Target hashrate limit (0 = maximum)
# target_hashrate = 0

# -----------------------------------------------------------------------------
#                       FPGA WORKER EXAMPLE
# -----------------------------------------------------------------------------
# ⚠️ FPGA only supported for HASH channel

# [[workers]]
# id = "fpga0"                      # Unique worker identifier
# hardware = "fpga"                 # Worker type
# serial_port = "/dev/ttyUSB0"      # Serial port: /dev/ttyUSB0 (Linux), COM1 (Windows)

# =============================================================================
#                         USAGE GUIDE
# =============================================================================
#
# GETTING STARTED:
# ================
# 1. Generate Falcon keys:
#    ./NexusMiner --create-keys
#
# 2. Get Tritium genesis hash:
#    nexus list accounts
#
# 3. Whitelist miner on Nexus node:
#    Add to nexus.conf: -minerallowkey=<your_falcon_pubkey>
#    Restart Nexus node
#
# MULTI-CORE CPU MINING (PRIME):
# ==============================
# Create N workers with 1 thread each:
# - 4-core: 3-4 workers (leave 1 core for system)
# - 8-core: 6-7 workers
# - 16-core: 12-14 workers
# - 32-core: 24-28 workers
# - 64-core: 48-56 workers
# - 128-core Threadripper: 96-112 workers
#
# MULTI-GPU MINING (HASH):
# ========================
# Create one worker per GPU with unique device index:
# [[workers]]
# id = "gpu0"
# hardware = "gpu"
# device = 0
#
# [[workers]]
# id = "gpu1"
# hardware = "gpu"
# device = 1
#
# POWER EFFICIENCY:
# =================
# GPU power_limit_percent recommendations:
# - Maximum performance: 100%
# - Balanced: 80-85% (best efficiency/performance ratio)
# - Efficiency focused: 70-75%
# - Ultra-efficient: 50-65%
#
# REMOTE/VPN MINING:
# ==================
# - Set wallet_ip to node's IP/hostname
# - Set local_ip to "0.0.0.0"
# - TLS and ChaCha20 auto-enable for non-localhost
# - Consider using VPN for additional security
#
# =============================================================================
