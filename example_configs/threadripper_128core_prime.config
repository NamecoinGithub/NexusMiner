# =============================================================================
#                    NUMA OPTIMIZATION
# =============================================================================
# For multi-socket systems or NUMA-aware tuning:
# 1. Use affinity_mask to pin workers to specific cores
# 2. Keep workers on the same NUMA node as their memory
# 3. Use 'numactl --hardware' to identify your NUMA topology
#
# Example with affinity:
# [[workers]]
# id = "cpu0"
# hardware = "cpu"
# threads = 1
# affinity_mask = 1  # Pin to core 0
# =============================================================================
