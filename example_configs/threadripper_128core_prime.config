# =============================================================================
#           NEXUSMINER 128-CORE THREADRIPPER CONFIGURATION
#              Optimized for High-Core-Count CPUs
# =============================================================================
#
# Configuration for AMD Threadripper or EPYC with 128 cores (or similar).
# Uses 96 workers (75% of cores) to leave headroom for system tasks.
#
# Scale up/down the worker count based on your actual core count.
#
# =============================================================================

version = 1

# =============================================================================
#                         CONNECTION
# =============================================================================

wallet_ip = "127.0.0.1"
port = 8323
local_ip = "0.0.0.0"
mining_mode = "PRIME"

# =============================================================================
#                    FALCON AUTHENTICATION
# =============================================================================

miner_falcon_pubkey = "<YOUR_PUBKEY_HEX>"
miner_falcon_privkey = "<YOUR_PRIVKEY_HEX>"
tritium_genesis = "<YOUR_GENESIS_64_HEX>"

# =============================================================================
#                        SETTINGS
# =============================================================================

connection_retry_interval = 5
print_statistics_interval = 60
log_level = 2
logfile = "threadripper.log"
keepalive_interval = 24

# =============================================================================
#                    STATISTICS OUTPUT
# =============================================================================

[[stats_printers]]
mode = "console"

[[stats_printers]]
mode = "file"
filename = "stats.log"

# =============================================================================
#                   WORKER CONFIGURATION
# =============================================================================
# 96 workers for 128-core CPU (leaving 32 cores for system)
# priority = 3 (above_normal) for dedicated mining rigs
# Disable efficiency_cores if you want to tune NUMA affinity

# Workers 0-9
[[workers]]
id = "cpu0"
hardware = "cpu"
threads = 1
priority = 3

